# Cloudflare Workers static assets reads this file (it is not served).
# Files under /_next/static/ have content hashes in their names and never change,
# so browsers may keep them for a year. Pages keep Cloudflare's default
# (revalidate on every visit), so a deploy shows up immediately.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Preferred for the current Next.js server-rendered app
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional fallback if a browser component creates Supabase without server-passed config.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Legacy compatibility only. Do not use these as the primary Vercel config.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Required for POST /api/internal/revalidate
REVALIDATE_SECRET=your-long-random-secret
